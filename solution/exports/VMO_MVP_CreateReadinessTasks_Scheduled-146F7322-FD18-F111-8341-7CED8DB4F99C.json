                      "item/VMO_RequestId": "@concat('RR-', guid())",
                      "item/Procurement/Value": "@items('Apply_to_each')?['Procurement']",
                      "item/SAM/Value": "@items('Apply_to_each')?['SAM']",
                      "item/Vendor": "@items('Apply_to_each')?['Vendor']",
                      "item/Product": "@items('Apply_to_each')?['Product']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "PostItem",
                      "connectionName": "shared_sharepointonline"
                    }
                  }
                },
                "Update_item": {
                  "runAfter": {
                    "Update_item_2": [
