                  "metadata": {
                    "operationMetadataId": "a0fce8d6-66ff-46e3-93ef-393430adc135"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://ashurst.sharepoint.com/sites/ITBudgetWorkingGroup",
                      "table": "c86e140f-05c9-45b4-b3db-cf9415653b69",
                      "id": "@outputs('Create_item')?['body/ID']",
                      "item/Title": "@items('Apply_to_each')?['BudgetCode']",
                      "item/RequestStatus/Value": "Open",
                      "item/Deeplink": "@concat(\n  'https://apps.powerapps.com/play/e/Default-0bb6abcc-a4cb-4fe2-9b52-d3ab6bae9014/a/b1c445c9-c36a-475c-b956-1a226e5131f2?requestId=',\n  outputs('Create_item')?['body/VMO_RequestId']\n)",
                      "item/IsThisStillRequired_x003f_": true
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "PatchItem",
                      "connectionName": "shared_sharepointonline"
                    }
                  }
                }
