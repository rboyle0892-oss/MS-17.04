                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://ashurst.sharepoint.com/sites/ITBudgetWorkingGroup",
                      "table": "a7d5157e-523c-40a5-9b16-7c3118a86fb9",
                      "id": "@items('Apply_to_each')?['ID']",
                      "item/Title": "@items('Apply_to_each')?['BudgetCode']",
                      "item/VMO_IsActive": true,
                      "item/VMO_ReadinessOpenCount": 1,
